{
  "name": "match-statistic",
  "private": false,
  "version": "0.2.2",
  "description": "Swiss / playoff tournament manager for card games and small competitive events, with ranking, Excel import, and GitHub Pages deployment.",
  "author": "ShiyiPai",
  "license": "MIT",
  "keywords": [
    "tournament",
    "swiss",
    "playoff",
    "ranking",
    "scoreboard",
    "card-games",
    "react",
    "typescript",
    "excel-import",
    "github-pages"
  ],
  "homepage": "https://yyt43.github.io/match-statistic/",
  "repository": {
    "type": "git",
    "url": "https://github.com/yyt43/match-statistic.git"
  },
  "bugs": {
    "url": "https://github.com/yyt43/match-statistic/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "check": "tsc -b --noEmit",
    "deploy": "npm run build && gh-pages -d dist",
    "generate:icons": "node scripts/generate-icons.mjs",
    "smoke": "node scripts/browser-smoke.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "html2canvas": "^1.4.1",
    "lucide-react": "^0.511.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.3.0",
    "tailwind-merge": "^3.0.2",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/html2canvas": "^1.0.0",
    "@types/node": "^22.15.30",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "babel-plugin-react-dev-locator": "^1.0.6",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "gh-pages": "^6.1.0",
    "globals": "^16.0.0",
    "playwright-core": "^1.63.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^2.1.9"
  }
}
