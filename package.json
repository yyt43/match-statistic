{
  "name": "match-statistic",
  "private": false,
  "version": "0.3.0",
  "description": "Swiss / playoff tournament manager for card games and small competitive events, with ranking, Excel import, and GitHub Pages deployment.",
  "author": "ShiyiPai",
  "license": "MIT",
  "keywords": [
    "tournament",
    "swiss",
    "playoff",
    "ranking",
    "scoreboard",
    "card-games",
    "react",
    "typescript",
    "excel-import",
    "github-pages"
  ],
  "homepage": "https://yyt43.github.io/match-statistic/",
  "repository": {
    "type": "git",
    "url": "https://github.com/yyt43/match-statistic.git"
  },
  "bugs": {
    "url": "https://github.com/yyt43/match-statistic/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "check": "tsc -b --noEmit",
    "deploy": "npm run build && gh-pages -d dist",
    "generate:icons": "node scripts/generate-icons.mjs",
    "generate:readme": "node scripts/generate-readme-assets.mjs",
    "smoke": "node scripts/browser-smoke.mjs",
    "smoke:offline": "node scripts/offline-smoke.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "visual:check": "node scripts/visual-regression.mjs",
    "visual:update": "node scripts/visual-regression.mjs --update"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "html2canvas": "^1.4.1",
    "lucide-react": "^0.577.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.3",
    "tailwind-merge": "^3.0.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/html2canvas": "^1.0.0",
    "@types/node": "^22.15.30",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/coverage-v8": "^5.0.0",
    "autoprefixer": "^10.5.5",
    "babel-plugin-react-dev-locator": "^1.0.6",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.6",
    "gh-pages": "^6.1.0",
    "globals": "^16.0.0",
    "pixelmatch": "^7.2.0",
    "playwright-core": "^1.63.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.3.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^5.0.0"
  }
}
